# ✏️ TEAM GUIDE: Copy this file to ".env" and fill in values if needed.
# The app works 100% offline with NO keys — these are optional future hooks.

# Optional: real LLM for the Nasma AI Assistant (Phase 5+).
# When empty, the built-in offline bilingual intent engine is used instead.
VITE_LLM_API_URL=
VITE_LLM_API_KEY=
VITE_LLM_MODEL=

# Optional: future REST backend base URL (see docs/API_CONTRACT.md).
# When empty, the local data layer (localStorage) is used.
VITE_API_BASE_URL=
